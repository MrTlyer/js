[Script]
http-response ^https?:\/\/.*mgtv\.com.*(?:GetUserInfo|module\/list\?_support|app\/bdboot|pullReleaseInfo|floor\/detail|video\/source|entry\?_support).*$ script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mgtv.js,timeout=60,requires-body=true,tag=mgtv,enable=true

http-request ^https?:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source\? script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/mgtk.js,timeout=60,tag=mgtk,enable=true

[Rewrite]
^https?:\/\/mobile\.da\.mgtv\.com\/m\/page reject

[MITM]
hostname = *.mgtv.com,hb-boom.api.mgtv.com,*.api.mgtv.com,mobile-stream.api.mgtv.com,nuc.api.mgtv.com,111.31.104.108,111.31.104.*,111.31.104.96,iphone.v0.mgtv.com,api.data.mgtv.com

